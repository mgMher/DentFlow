# Server
API_PORT=8000
MODE=DEV
CLIENT_URL=http://localhost:3000
# CLIENT_URL is also the address in password-reset emails (F9): the web app's public https address in production.

# MongoDB
MONGO_URI=mongodb://localhost:27017/dentflow

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Patient documents and X-rays (F6). Keep this folder on a persistent volume and in backups.
UPLOAD_DIR=./uploads
# Largest file accepted, in MB (default 20)
DOCUMENTS_MAX_MB=20

# Number of reverse-proxy hops in front of the API (e.g. 1 behind a load balancer)
# TRUST_PROXY=1

# Appointment reminders (F3)
# Encrypts clinics' Telegram bot tokens, SMS provider tokens and staff two-factor secrets (F9). Required when MODE=PROD.
SECRETS_KEY=change-me-to-a-long-random-string
# Public address of this API, so Telegram can deliver patients' messages and button presses (https://…, no /api).
PUBLIC_API_URL=
# Local development without a public URL: fetch Telegram updates by polling instead (1 = on).
TELEGRAM_POLLING=
# Set to "off" to stop the every-minute reminder job (tests do this).
REMINDERS_CRON=

# Email (F9): password-reset links. Without SMTP_HOST, emails are written to the server log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="DentFlow <no-reply@example.com>"

# Two-factor sign-in (F9): roles that must use an authenticator app (comma-separated), or "none".
# Default: super_admin,clinic_admin
# TWO_FACTOR_REQUIRED_ROLES=super_admin,clinic_admin
